APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# Canonical Web origin for verification/reset completion links (not the API origin).
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://localhost:5432/barclimb
REDIS_URL=redis://localhost:6379/0
READINESS_REQUIRE_KVS=true
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
# Public API origins used by the local Web proxy and native client.
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
