APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
# Canonical Web origin for verification/reset completion links (not the API origin).
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://localhost:5432/barclimb
REDIS_URL=redis://localhost:6379/0
# Heroku KVS only: opt into its documented self-signed TLS certificate handling.
REDIS_TLS_ALLOW_SELF_SIGNED=false
READINESS_REQUIRE_KVS=true
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
ALLOW_STAGING_AUTH_EMAIL_SINK=false
DEFAULT_FROM_EMAIL=no-reply@localhost
# Public API origins used by the local Web proxy and native client.
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5173
# Keep false until verified Apple/Android signing identities are configured.
MOBILE_LINKS_ENABLED=false
APPLE_TEAM_ID=
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
