{
  "name": "barclimb",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "npm": "11.17.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "workspaces": [
    "apps/web",
    "apps/native",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @barclimb/web",
    "heroku-postbuild": "npm run build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "continuity": "python3 scripts/validate_continuity.py",
    "format": "prettier --write package.json package-lock.json eslint.config.js tsconfig.base.json .github/workflows/ci.yml apps/web apps/native packages docs/implementation",
    "format:check": "prettier --check package.json package-lock.json eslint.config.js tsconfig.base.json .github/workflows/ci.yml apps/web apps/native packages docs/implementation",
    "lint": "eslint apps/web/src apps/native packages --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "portability": "eslint packages --max-warnings=0 && npm run typecheck --workspace @barclimb/analytics-events --workspace @barclimb/api-client --workspace @barclimb/assessment-schema --workspace @barclimb/design-tokens --workspace @barclimb/domain-types --workspace @barclimb/feature-flags --workspace @barclimb/validation",
    "test": "npm run test --workspaces --if-present",
    "web:dev": "npm run dev --workspace @barclimb/web",
    "native:start": "npm run start --workspace @barclimb/native"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.42.0",
    "zod-validation-error": "4.0.2"
  }
}
